RewriteEngine On

# Keep real files and directories working normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# BargaiNest is a hash-routed SPA, but password reset and
# email-verification links arrive as normal paths.
RewriteRule ^ index.html [L]
